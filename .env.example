# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.
PORT=8087
LOG_LEVEL=info
# TRUST_PROXY=1

MONGO_URL=mongodb://notification_svc:change-me-notification@localhost:27017/notification_db?authSource=notification_db
AMQP_URL=amqp://festa:change-me-rabbit@localhost:5672
JWT_ISSUER=festa-auth
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
# FESTA_CONTRACTS_DIR=../festa-infra/contracts

# JSON de la cuenta de servicio de Firebase (Configuración del proyecto → Cuentas de servicio).
# Sin él (o con el placeholder {}), las notificaciones solo quedan en la bandeja de la app.
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# RF12: eventos cercanos y recordatorios
NEARBY_RADIUS_METERS=3000
LOCATION_MAX_AGE_HOURS=72
NEARBY_MAX_RECIPIENTS=500
REMINDER_HOURS_BEFORE=2
